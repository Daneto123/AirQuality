# Copy this file to .env and fill in your own values. Never commit .env.
# docker compose reads it automatically.

# InfluxDB
INFLUXDB_USERNAME=admin
INFLUXDB_PASSWORD=change-me
INFLUX_TOKEN=change-me-to-a-long-random-token
INFLUX_BUCKET=sensorBucket
ORG=VratsaSoft

# External APIs
OPENWEATHER_API_KEY=your-openweathermap-api-key
OPENCAGE_API_KEY=your-opencage-api-key

# SMTP for air-quality alert emails
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_USER=alerts@example.com
SMTP_PASS=your-smtp-password

# Express session
SESSION_SECRET=change-me-to-a-long-random-string

# Address the browser uses to reach the API (frontend build)
PUBLIC_API_URL=http://localhost:3060
